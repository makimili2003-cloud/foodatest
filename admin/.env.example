# ===== FoodAR admin – podešavanja =====
# Kopiraj ovaj fajl u ".env" i popuni vrednosti.

# PIN koji se unosi na telefonu pre korišćenja panela (izaberi svoj)
ADMIN_PIN=1234

# GitHub token sa dozvolom "Contents: Read and write" za repo foodatest
# Napravi ga ovde: https://github.com/settings/personal-access-tokens/new
GITHUB_TOKEN=
GITHUB_REPO=makimili2003-cloud/foodatest
GITHUB_BRANCH=main

# Netlify (opciono, za automatsko pravljenje poddomena kao pizza.foodar.org)
# Token: https://app.netlify.com/user/applications#personal-access-tokens
NETLIFY_TOKEN=
# ID sajta (Site configuration -> Site details -> Site ID) ili samo domen sajta
NETLIFY_SITE_ID=foodar.org

# Glavni domen
DOMAIN=foodar.org

# Port lokalnog servera
PORT=3000
